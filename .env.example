# Copy to .env and fill in. Never commit .env.

# Meta Model API (https://dev.meta.ai) - Standard mode key
MODEL_API_KEY=

# Baseten (Muse Spark Open, hackathon credits)
BASETEN_API_KEY=

# Fireworks (optional serving for Meta open-weight models, hackathon credits)
FIREWORKS_API_KEY=

# Modal: not read from here. Run `uv run modal token set --token-id <id> --token-secret <secret>`
# (or `uv run modal setup`) once; it stores the token in ~/.modal.toml.

# Hugging Face read token; your account needs access to facebook/sam-3d-objects (gated).
# Used on Modal as a secret (M4).
HF_TOKEN=

# Optional: where data lives (default ./data)
# MR_DATA_DIR=
