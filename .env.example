# Copy to .env and fill in. Never commit .env.

# Meta Model API (https://dev.meta.ai) - Standard mode key
MODEL_API_KEY=

# Baseten (Muse Spark Open, hackathon credits)
BASETEN_API_KEY=

# Modal: run `uv run modal setup` once instead; it stores the token in ~/.modal.toml

# Hugging Face token with access to gated weights (SAM 3D Objects). Used on Modal as a secret.
HF_TOKEN=

# Optional: where data lives (default ./data)
# MR_DATA_DIR=
